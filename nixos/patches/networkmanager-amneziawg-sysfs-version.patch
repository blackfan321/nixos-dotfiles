From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursor@cursor.com>
Date: Sun, 30 Aug 2026 01:30:00 +0300
Subject: [PATCH] fix: sysfs amneziawg version is always 1.0.0 on 3.x modules

Upstream PR #9 detects ABI via /sys/module/amneziawg/version major >= 3,
but nixpkgs 3.x modules still report "1.0.0" there. Default to the current
ABI and fall back to legacy formats on EINVAL instead.
---
 shared/amneziawg.c | 23 +++++++++++++++--------
 1 file changed, 15 insertions(+), 8 deletions(-)

diff --git a/shared/amneziawg.c b/shared/amneziawg.c
index b844d57..c1a2e91 100644
--- a/shared/amneziawg.c
+++ b/shared/amneziawg.c
@@ -31,9 +31,8 @@
  *  - magic headers (H1..H4) were NUL strings in old kernels and became
  *    packed u64 ranges (u32_range_t, hi<<32|lo) in newer ones;
  *  - peer keepalive interval was u16 and became u32.
- * Detect the format from the loaded module version (3.x = new ABI,
- * older = legacy). When the version cannot be read, default to the new
- * ABI and fall back to legacy if the kernel rejects the request.
+ * Prefer the current ABI and fall back to legacy on EINVAL. Sysfs version
+ * is often "1.0.0" even on 3.x modules, so major-only checks are unreliable.
  */
 static bool
 awg_kernel_uses_current_abi(bool *known)
@@ -56,8 +55,17 @@ awg_kernel_uses_current_abi(bool *known)
     if (sscanf(buf, "%u", &major) != 1)
         return true;
 
-    *known = true;
-    return major >= 3;
+    if (major >= 3) {
+        *known = true;
+        return true;
+    }
+
+    if (major <= 2 && major != 1) {
+        *known = true;
+        return false;
+    }
+
+    return true;
 }
 
 /* wireguard.h netlink uapi: */
@@ -1355,10 +1363,8 @@ wg_set_device(wg_device *dev)
     errno = 0;
     if (mnlg_socket_recv_run(nlg, NULL, NULL) < 0) {
         ret = errno ? -errno : -EINVAL;
-        /* If we guessed the wrong ABI (module version unreadable), recreate
-         * the interface and retry once with the legacy formats. */
-        if (ret == -EINVAL && !known_abi) {
-            known_abi = true;
+        /* Wrong ABI guess: recreate the interface and retry once with legacy. */
+        if (ret == -EINVAL && current_abi) {
             current_abi = false;
             peer = NULL;
             allowedip = NULL;
