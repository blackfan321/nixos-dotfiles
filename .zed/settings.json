{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/nix/store/**",
    "**/result",
    "**/result-*"
  ],
  "languages": {
    "Nix": {
      "language_servers": ["nixd"]
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        "formatting": {
          "command": ["nixfmt"]
        },
        "options": {
          "home-manager": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.nixos.options.home-manager.users.type.getSubOptions []"
          }
        }
      }
    }
  }
}
